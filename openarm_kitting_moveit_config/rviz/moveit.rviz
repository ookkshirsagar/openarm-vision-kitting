Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: moveit_task_constructor/Motion Planning Tasks
    Name: Motion Planning Tasks
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: world
      Plane Cell Count: 20
      Cell Size: 0.1
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Geometry:
        Scene Alpha: 0.9
      Scene Robot:
        Robot Alpha: 1
      Planning Request:
        Planning Group: right_arm
        Interactive Marker Size: 0.15
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trail Step Size: 1
    - Class: moveit_task_constructor/Motion Planning Tasks
      Name: Motion Planning Tasks
      Enabled: true
      Task Solution Topic: /solution
      Robot Description: robot_description
    - Class: rviz_default_plugins/Image
      Name: Head camera
      Enabled: true
      Topic:
        Value: /zed/rgb/image_rect_color
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/MarkerArray
      Name: Detections
      Enabled: true
      Topic:
        Value: /kitting/detections_markers
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Focal Point: {X: 0.35, Y: 0.0, Z: 0.45}
      Pitch: 0.55
      Yaw: 3.6
Window Geometry:
  Width: 1600
  Height: 1000
